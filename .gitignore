# ==============================================================================
# Git Ignore Configuration for Phishing Analysis & ML Cybersecurity Project
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, Caches & Compilation Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 2. Large Datasets & Raw Data (Prevents GitHub 100MB limit block)
# ------------------------------------------------------------------------------
# email_text.csv is ~92 MB (exceeds GitHub 50MB warning threshold)
data/*.csv
data/*.zip
data/*.tar.gz
data/*.parquet
data/*.sqlite3

# Keep data directory structure intact
!data/.gitkeep

# ------------------------------------------------------------------------------
# 3. Machine Learning Model Artifacts (Generated Reproducible Binaries)
# ------------------------------------------------------------------------------
models/*.joblib
models/*.pkl
models/*.pt
models/*.h5
models/*.onnx
*.joblib
*.pkl

# Keep models directory structure intact
!models/.gitkeep

# ------------------------------------------------------------------------------
# 4. Virtual Environments
# ------------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 5. IDEs, Editors & Operating System Metadata
# ------------------------------------------------------------------------------
# VS Code
.vscode/
*.code-workspace

# PyCharm / JetBrains
.idea/
*.iws
*.iml

# Windows System Files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS System Files
.DS_Store
.AppleDouble
.LSOverride

# ------------------------------------------------------------------------------
# 6. Logs, Temporary Caches & Scratch Files
# ------------------------------------------------------------------------------
*.log
*.tmp
temp/
tmp/
scratch/
.matplotlib/
